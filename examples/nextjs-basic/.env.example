# Copy to `.env.local` (development) or `.env` (production).
# Next.js loads these automatically; @dyanet/nextjs-config-aws also reads them via
# its EnvFileLoader so the same values flow through getConfig().

APP_NAME=nextjs-config-aws-demo
PUBLIC_APP_NAME=nextjs-config-aws-demo
PUBLIC_API_URL=http://localhost:3000

# Server-only:
# DATABASE_URL=postgres://localhost/demo

# AWS settings (only used when getConfig({ aws: {...} }) is enabled):
# AWS_REGION=us-east-1
# AWS_PROFILE=myprofile
# SECRET_NAME=/my-app/config
