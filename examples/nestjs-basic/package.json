{
  "name": "config-aws-example-nestjs-basic",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal NestJS app using @dyanet/nestjs-config-aws",
  "scripts": {
    "start": "ts-node src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@dyanet/nestjs-config-aws": "^2.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "dotenv": "^16.4.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.9.0"
  },
  "comments": {
    "optional-aws": "Install AWS SDK clients only for the loaders you actually use:",
    "secrets-manager": "npm install @aws-sdk/client-secrets-manager",
    "ssm": "npm install @aws-sdk/client-ssm"
  }
}
