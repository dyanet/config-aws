# Copy to `.env`. Loaded by `dotenv/config` at the top of src/main.ts.
APP_NAME=nestjs-config-aws-demo
PORT=3000
FEATURE_FLAG=true

# APP_ENV controls AWS loading:
#   - 'local' (default): AWS loaders skip themselves; only env vars are used.
#   - 'development' / 'test' / 'production': AWS loaders run with their env-mapped paths.
# APP_ENV=development

# AWS settings (only needed when the AWS loaders actually run):
# AWS_REGION=us-east-1
# AWS_PROFILE=myprofile
# SECRET_NAME=/my-app/config
# SSM_PREFIX=/my-app
